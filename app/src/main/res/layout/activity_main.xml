<?xml version="1.0" encoding="utf-8"?>
<!-- FIXED: FrameLayout → ConstraintLayout; added totalScoreText + shareButton -->
<androidx.constraintlayout.widget.ConstraintLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent">

    <!-- Full-screen background (unchanged) -->
    <ImageView
        android:id="@+id/mainBackground"
        android:layout_width="0dp"
        android:layout_height="0dp"
        android:src="@drawable/main_bg"
        android:scaleType="centerCrop"
        android:contentDescription="@null"
        app:layout_constraintTop_toTopOf="parent"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent" />

    <!-- Total score banner — updated in MainActivity.onResume() from SharedPreferences -->
    <TextView
        android:id="@+id/totalScoreText"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="⭐ Total Stars: 0"
        android:textSize="18sp"
        android:textStyle="bold"
        android:textColor="#FFFFFF"
        android:background="#88000000"
        android:padding="6dp"
        android:layout_marginTop="16dp"
        app:layout_constraintTop_toTopOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent" />

    <!-- Alphabet button — top-left hit zone over background image -->
    <Button
        android:id="@+id/alphabetButton"
        android:layout_width="0dp"
        android:layout_height="130dp"
        android:layout_marginStart="24dp"
        android:layout_marginEnd="8dp"
        android:background="@android:color/transparent"
        android:text=""
        android:stateListAnimator="@null"
        app:layout_constraintTop_toBottomOf="@id/totalScoreText"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toStartOf="@id/numbersButton"
        app:layout_constraintBottom_toTopOf="@id/animalsButton"
        app:layout_constraintVertical_chainStyle="packed"
        app:layout_constraintVertical_bias="0.70" />

    <!-- Numbers button — top-right -->
    <Button
        android:id="@+id/numbersButton"
        android:layout_width="0dp"
        android:layout_height="130dp"
        android:layout_marginStart="8dp"
        android:layout_marginEnd="24dp"
        android:background="@android:color/transparent"
        android:text=""
        android:stateListAnimator="@null"
        app:layout_constraintTop_toTopOf="@id/alphabetButton"
        app:layout_constraintStart_toEndOf="@id/alphabetButton"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintBottom_toBottomOf="@id/alphabetButton" />

    <!-- Animals button — bottom-left -->
    <Button
        android:id="@+id/animalsButton"
        android:layout_width="0dp"
        android:layout_height="130dp"
        android:layout_marginStart="24dp"
        android:layout_marginEnd="8dp"
        android:layout_marginTop="16dp"
        android:background="@android:color/transparent"
        android:text=""
        android:stateListAnimator="@null"
        app:layout_constraintTop_toBottomOf="@id/alphabetButton"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toStartOf="@id/shapesButton"
        app:layout_constraintBottom_toTopOf="@id/shareButton" />

    <!-- Shapes button — bottom-right -->
    <Button
        android:id="@+id/shapesButton"
        android:layout_width="0dp"
        android:layout_height="130dp"
        android:layout_marginStart="8dp"
        android:layout_marginEnd="24dp"
        android:background="@android:color/transparent"
        android:text=""
        android:stateListAnimator="@null"
        app:layout_constraintTop_toTopOf="@id/animalsButton"
        app:layout_constraintStart_toEndOf="@id/animalsButton"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintBottom_toBottomOf="@id/animalsButton" />

    <!-- Share Score button — fires implicit ACTION_SEND Intent -->
    <Button
        android:id="@+id/shareButton"
        android:layout_width="0dp"
        android:layout_height="52dp"
        android:layout_marginStart="32dp"
        android:layout_marginEnd="32dp"
        android:layout_marginBottom="24dp"
        android:text="📤 Share My Score"
        android:textSize="16sp"
        android:textStyle="bold"
        android:textColor="#FFFFFF"
        android:background="@drawable/btn_next"
        android:stateListAnimator="@null"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent" />

</androidx.constraintlayout.widget.ConstraintLayout>