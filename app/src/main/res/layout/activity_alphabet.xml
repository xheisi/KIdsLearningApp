<?xml version="1.0" encoding="utf-8"?>
<!-- FIXED: FrameLayout root → ConstraintLayout; all child positions use constraint attributes -->
<androidx.constraintlayout.widget.ConstraintLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:id="@+id/rootFrame"
    android:layout_width="match_parent"
    android:layout_height="match_parent">

    <!-- ① Background colour (animated in AlphabetActivity) -->
    <View
        android:id="@+id/bgView"
        android:layout_width="0dp"
        android:layout_height="0dp"
        android:background="#FF6B6B"
        app:layout_constraintTop_toTopOf="parent"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent" />

    <!-- ② Decorative bubbles (positioned via margins from edges) -->
    <View
        android:layout_width="220dp"
        android:layout_height="220dp"
        android:background="@drawable/bubble_white_large"
        android:alpha="0.18"
        android:layout_marginTop="-60dp"
        android:layout_marginEnd="-60dp"
        app:layout_constraintTop_toTopOf="parent"
        app:layout_constraintEnd_toEndOf="parent" />

    <View
        android:layout_width="140dp"
        android:layout_height="140dp"
        android:background="@drawable/bubble_white_large"
        android:alpha="0.14"
        android:layout_marginBottom="-40dp"
        android:layout_marginStart="-40dp"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintStart_toStartOf="parent" />

    <View
        android:layout_width="80dp"
        android:layout_height="80dp"
        android:background="@drawable/bubble_white_large"
        android:alpha="0.12"
        android:layout_marginEnd="-25dp"
        app:layout_constraintTop_toTopOf="parent"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toEndOf="parent" />

    <!-- ③ Main content column — constrained to fill screen -->
    <LinearLayout
        android:id="@+id/contentColumn"
        android:layout_width="0dp"
        android:layout_height="0dp"
        android:orientation="vertical"
        app:layout_constraintTop_toTopOf="parent"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent">

        <!-- TOP BAR -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:gravity="center_vertical"
            android:paddingStart="12dp"
            android:paddingEnd="12dp"
            android:paddingTop="12dp"
            android:paddingBottom="4dp">

            <Button
                android:id="@+id/backButton"
                android:layout_width="44dp"
                android:layout_height="44dp"
                android:text="←"
                android:textSize="20sp"
                android:textColor="#FFFFFF"
                android:background="@drawable/btn_circle_white"
                android:padding="0dp"
                android:stateListAnimator="@null" />

            <TextView
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:text="✏️ ALPHABET"
                android:gravity="center"
                android:textSize="22sp"
                android:textStyle="bold"
                android:fontFamily="sans-serif-black"
                android:textColor="#FFFFFF"
                android:shadowColor="#44000000"
                android:shadowDx="0"
                android:shadowDy="2"
                android:shadowRadius="4" />

            <TextView
                android:id="@+id/progressText"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="1 / 10"
                android:textSize="15sp"
                android:textStyle="bold"
                android:textColor="#FFFFFF"
                android:background="@drawable/badge_white_pill"
                android:paddingStart="10dp"
                android:paddingEnd="10dp"
                android:paddingTop="4dp"
                android:paddingBottom="4dp" />
        </LinearLayout>

        <!-- STAR ROW -->
        <LinearLayout
            android:id="@+id/starsRow"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:gravity="center"
            android:paddingBottom="6dp" />

        <!-- LETTER CARD -->
        <FrameLayout
            android:id="@+id/letterCard"
            android:layout_width="match_parent"
            android:layout_height="0dp"
            android:layout_weight="1"
            android:layout_marginStart="16dp"
            android:layout_marginEnd="16dp"
            android:layout_marginBottom="8dp">

            <View
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:background="@drawable/letter_card_bg" />

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:orientation="vertical"
                android:gravity="center">

                <TextView
                    android:id="@+id/letterBig"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="A"
                    android:textSize="148sp"
                    android:fontFamily="sans-serif-black"
                    android:textStyle="bold"
                    android:textColor="#22000000"
                    android:includeFontPadding="false" />

                <TextView
                    android:id="@+id/letterSmall"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="a"
                    android:textSize="72sp"
                    android:fontFamily="sans-serif-black"
                    android:textStyle="bold"
                    android:textColor="#33000000"
                    android:layout_marginTop="-16dp" />

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="☝️ Trace the letters!"
                    android:textSize="13sp"
                    android:textColor="#66000000"
                    android:textStyle="italic"
                    android:layout_marginTop="6dp" />
            </LinearLayout>

            <!-- Trace canvas -->
            <com.example.kidslearningapp.LetterTraceView
                android:id="@+id/traceView"
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:background="#00000000" />

            <!-- Hint pill -->
            <TextView
                android:id="@+id/traceHintText"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_gravity="center_horizontal|bottom"
                android:layout_marginBottom="12dp"
                android:text="🎯 Trace over the letter!"
                android:textSize="16sp"
                android:textStyle="bold"
                android:textColor="#FFFFFF"
                android:background="@drawable/hint_pill_bg"
                android:paddingStart="16dp"
                android:paddingEnd="16dp"
                android:paddingTop="8dp"
                android:paddingBottom="8dp"
                android:shadowColor="#55000000"
                android:shadowDx="0"
                android:shadowDy="2"
                android:shadowRadius="4"
                android:visibility="gone" />
        </FrameLayout>

        <!-- EMOJI + WORD HINT -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:gravity="center"
            android:paddingBottom="8dp">

            <TextView
                android:id="@+id/emojiText"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="🍎"
                android:textSize="32sp" />

            <TextView
                android:id="@+id/wordHintText"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="like Apple!"
                android:textSize="18sp"
                android:textStyle="bold"
                android:fontFamily="sans-serif-medium"
                android:textColor="#FFFFFF"
                android:shadowColor="#44000000"
                android:shadowDx="0"
                android:shadowDy="1"
                android:shadowRadius="3"
                android:layout_marginStart="8dp" />
        </LinearLayout>

        <!-- BOTTOM BUTTONS -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:paddingStart="12dp"
            android:paddingEnd="12dp"
            android:paddingBottom="16dp"
            android:gravity="center">

            <Button
                android:id="@+id/hearButton"
                android:layout_width="0dp"
                android:layout_height="56dp"
                android:layout_weight="1"
                android:layout_marginEnd="6dp"
                android:text="🔊 Hear It"
                android:textSize="15sp"
                android:textStyle="bold"
                android:textColor="#FFFFFF"
                android:background="@drawable/btn_hear"
                android:stateListAnimator="@null" />

            <Button
                android:id="@+id/clearButton"
                android:layout_width="56dp"
                android:layout_height="56dp"
                android:layout_marginEnd="6dp"
                android:text="🗑️"
                android:textSize="22sp"
                android:background="@drawable/btn_circle_white"
                android:stateListAnimator="@null" />

            <Button
                android:id="@+id/nextButton"
                android:layout_width="0dp"
                android:layout_height="56dp"
                android:layout_weight="1.2"
                android:text="Next ➡️"
                android:textSize="16sp"
                android:textStyle="bold"
                android:textColor="#FFFFFF"
                android:background="@drawable/btn_next_alpha"
                android:stateListAnimator="@null" />
        </LinearLayout>
    </LinearLayout>

    <!-- ④ CELEBRATION OVERLAY — full screen, shown on completion -->
    <FrameLayout
        android:id="@+id/celebOverlay"
        android:layout_width="0dp"
        android:layout_height="0dp"
        android:background="@drawable/celebration_card"
        android:visibility="gone"
        app:layout_constraintTop_toTopOf="parent"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_gravity="center"
            android:orientation="vertical"
            android:gravity="center"
            android:padding="32dp">

            <TextView
                android:id="@+id/celebEmoji"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="🌟"
                android:textSize="88sp" />

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Amazing!"
                android:textSize="42sp"
                android:fontFamily="sans-serif-black"
                android:textStyle="bold"
                android:textColor="#FFFFFF"
                android:shadowColor="#44000000"
                android:shadowDx="0"
                android:shadowDy="3"
                android:shadowRadius="6"
                android:layout_marginTop="8dp" />

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="You traced all 10 letters! 🎉"
                android:textSize="18sp"
                android:textColor="#FFFFFFDD"
                android:gravity="center"
                android:layout_marginTop="8dp" />

            <Button
                android:id="@+id/playAgainButton"
                android:layout_width="220dp"
                android:layout_height="60dp"
                android:layout_marginTop="32dp"
                android:text="🔁 Play Again!"
                android:textSize="18sp"
                android:textStyle="bold"
                android:textColor="#FF6B6B"
                android:background="@drawable/btn_celeb_white"
                android:stateListAnimator="@null" />

            <Button
                android:id="@+id/menuButton"
                android:layout_width="220dp"
                android:layout_height="56dp"
                android:layout_marginTop="12dp"
                android:text="🏠 Main Menu"
                android:textSize="16sp"
                android:textStyle="bold"
                android:textColor="#FFFFFF"
                android:background="@drawable/btn_menu_outline"
                android:stateListAnimator="@null" />
        </LinearLayout>
    </FrameLayout>

</androidx.constraintlayout.widget.ConstraintLayout>