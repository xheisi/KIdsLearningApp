<?xml version="1.0" encoding="utf-8"?>
<!--
    Background image: name your file  shapes_bg  and place in res/drawable/.
    Top bar colour: #FDB1D0 (bubblegum pink) as requested.
-->
<FrameLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent">

    <!-- Background image -->
    <ImageView
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:src="@drawable/shapes_bg"
        android:scaleType="centerCrop"
        android:contentDescription="@null"/>

    <!-- Top bar — bubblegum pink -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_gravity="top"
        android:orientation="horizontal"
        android:gravity="center_vertical"
        android:background="#FDB1D0"
        android:padding="12dp"
        android:elevation="4dp">

        <Button
            android:id="@+id/backButton"
            android:layout_width="44dp"
            android:layout_height="44dp"
            android:text="←"
            android:textSize="20sp"
            android:textColor="#FFFFFF"
            android:background="@drawable/btn_circle_white"
            android:padding="0dp"
            android:stateListAnimator="@null"/>

        <TextView
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:text="🔷 SHAPES"
            android:gravity="center"
            android:textSize="22sp"
            android:textStyle="bold"
            android:fontFamily="sans-serif-black"
            android:textColor="#FFFFFF"
            android:shadowColor="#44000000"
            android:shadowDx="0"
            android:shadowDy="1"
            android:shadowRadius="3"/>

        <View android:layout_width="44dp" android:layout_height="44dp"/>
    </LinearLayout>

    <!-- Play canvas -->
    <FrameLayout
        android:id="@+id/dragCanvas"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:layout_marginTop="68dp"
        android:clipChildren="false"
        android:clipToPadding="false"/>

    <!-- Celebration overlay -->
    <FrameLayout
        android:id="@+id/celebOverlay"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:background="@drawable/celebration_card"
        android:visibility="gone">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_gravity="center"
            android:orientation="vertical"
            android:gravity="center"
            android:padding="32dp">

            <TextView
                android:id="@+id/celebEmoji"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="🎊"
                android:textSize="88sp"/>

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Well Done!"
                android:textSize="42sp"
                android:fontFamily="sans-serif-black"
                android:textStyle="bold"
                android:textColor="#FFFFFF"
                android:shadowColor="#44000000"
                android:shadowDx="0"
                android:shadowDy="3"
                android:shadowRadius="6"
                android:layout_marginTop="8dp"/>

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="You sorted all 6 shapes! 🔷🔺⭐"
                android:textSize="16sp"
                android:textColor="#FFFFFFDD"
                android:gravity="center"
                android:layout_marginTop="8dp"/>

            <Button
                android:id="@+id/playAgainButton"
                android:layout_width="220dp"
                android:layout_height="60dp"
                android:layout_marginTop="32dp"
                android:text="🔁 Play Again!"
                android:textSize="18sp"
                android:textStyle="bold"
                android:textColor="#FDB1D0"
                android:background="@drawable/btn_celeb_white"
                android:stateListAnimator="@null"/>

            <Button
                android:id="@+id/menuButton"
                android:layout_width="220dp"
                android:layout_height="56dp"
                android:layout_marginTop="12dp"
                android:text="🏠 Main Menu"
                android:textSize="16sp"
                android:textStyle="bold"
                android:textColor="#FFFFFF"
                android:background="@drawable/btn_menu_outline"
                android:stateListAnimator="@null"/>
        </LinearLayout>
    </FrameLayout>

</FrameLayout>