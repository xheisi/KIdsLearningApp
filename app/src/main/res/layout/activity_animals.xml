<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"

    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@drawable/animals">

    <!-- TOP BAR -->
    <LinearLayout
        android:id="@+id/topBar"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:gravity="center_vertical"
        android:background="@drawable/splash_background"
        android:padding="12dp"
        app:layout_constraintTop_toTopOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent">

        <Button
            android:id="@+id/backButton"
            android:layout_width="44dp"
            android:layout_height="44dp"
            android:text="←"
            android:textSize="20sp"
            android:textColor="#FFFFFF"
            android:background="@drawable/btn_tts"
            android:padding="0dp"
            android:stateListAnimator="@null" />

        <TextView
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:text="🐾 ANIMALS"
            android:gravity="center"
            android:textSize="22sp"
            android:textStyle="bold"
            android:textColor="#FFFFFF" />

        <TextView
            android:id="@+id/scoreText"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="⭐ 0"
            android:textSize="18sp"
            android:textStyle="bold"
            android:textColor="#FFEB3B" />
    </LinearLayout>

    <!-- PROGRESS ROW -->
    <LinearLayout
        android:id="@+id/progressRow"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:gravity="center_vertical"
        android:padding="12dp"
        app:layout_constraintTop_toBottomOf="@id/topBar"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent">

        <ProgressBar
            android:id="@+id/progressBar"
            style="@android:style/Widget.ProgressBar.Horizontal"
            android:layout_width="0dp"
            android:layout_height="14dp"
            android:layout_weight="1"
            android:progressDrawable="@drawable/progress_bar_drawable"
            android:max="10"
            android:progress="0" />

        <TextView
            android:id="@+id/progressText"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="1/10"
            android:textSize="14sp"
            android:textStyle="bold"
            android:textColor="#795548"
            android:layout_marginStart="8dp" />
    </LinearLayout>

    <!-- QUESTION LABEL -->
    <TextView
        android:id="@+id/questionLabel"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:text="Which animal is this?"
        android:gravity="center"
        android:textSize="18sp"
        android:textColor="#5D4037"
        android:paddingBottom="4dp"
        app:layout_constraintTop_toBottomOf="@id/progressRow"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent" />

    <!-- ANIMAL NAME + TTS -->
    <LinearLayout
        android:id="@+id/nameRow"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:gravity="center_vertical"
        android:padding="8dp"
        app:layout_constraintTop_toBottomOf="@id/questionLabel"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent">

        <TextView
            android:id="@+id/animalNameText"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="DOG"
            android:textSize="36sp"
            android:textStyle="bold"
            android:textColor="#E65100" />

        <Button
            android:id="@+id/ttsButton"
            android:layout_width="52dp"
            android:layout_height="52dp"
            android:layout_marginStart="16dp"
            android:text="🔊"
            android:textSize="22sp"
            android:background="@drawable/btn_tts"
            android:padding="0dp"
            android:stateListAnimator="@null" />
    </LinearLayout>

    <!--
        OPTION GRID
        Wrapped in a single vertical LinearLayout that is constrained between
        nameRow and feedbackText. The two inner rows each take layout_weight="1"
        so they split space equally. This avoids layout_constraintVertical_weight
        which only works inside a proper ConstraintLayout chain.
    -->
    <LinearLayout
        android:id="@+id/optionsGrid"
        android:layout_width="0dp"
        android:layout_height="0dp"
        android:orientation="vertical"
        app:layout_constraintTop_toBottomOf="@id/nameRow"
        app:layout_constraintBottom_toTopOf="@id/feedbackText"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent">

        <!-- TOP ROW: option1 + option2 -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="0dp"
            android:layout_weight="1"
            android:orientation="horizontal"
            android:padding="8dp"
            android:weightSum="2">

            <LinearLayout
                android:id="@+id/option1"
                android:layout_width="0dp"
                android:layout_height="match_parent"
                android:layout_weight="1"
                android:layout_margin="6dp"
                android:orientation="vertical"
                android:gravity="center"
                android:background="@drawable/quiz_option_normal"
                android:elevation="4dp"
                android:padding="8dp">

                <ImageView
                    android:id="@+id/option1Image"
                    android:layout_width="110dp"
                    android:layout_height="110dp"
                    android:scaleType="fitCenter"
                    android:src="@drawable/dog" />

                <TextView
                    android:id="@+id/option1Label"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Dog"
                    android:textSize="17sp"
                    android:textStyle="bold"
                    android:textColor="#3E2723" />
            </LinearLayout>

            <LinearLayout
                android:id="@+id/option2"
                android:layout_width="0dp"
                android:layout_height="match_parent"
                android:layout_weight="1"
                android:layout_margin="6dp"
                android:orientation="vertical"
                android:gravity="center"
                android:background="@drawable/quiz_option_normal"
                android:elevation="4dp"
                android:padding="8dp">

                <ImageView
                    android:id="@+id/option2Image"
                    android:layout_width="110dp"
                    android:layout_height="110dp"
                    android:scaleType="fitCenter"
                    android:src="@drawable/cat" />

                <TextView
                    android:id="@+id/option2Label"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Cat"
                    android:textSize="17sp"
                    android:textStyle="bold"
                    android:textColor="#3E2723" />
            </LinearLayout>
        </LinearLayout>

        <!-- BOTTOM ROW: option3 + option4 -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="0dp"
            android:layout_weight="1"
            android:orientation="horizontal"
            android:padding="8dp"
            android:weightSum="2">

            <LinearLayout
                android:id="@+id/option3"
                android:layout_width="0dp"
                android:layout_height="match_parent"
                android:layout_weight="1"
                android:layout_margin="6dp"
                android:orientation="vertical"
                android:gravity="center"
                android:background="@drawable/quiz_option_normal"
                android:elevation="4dp"
                android:padding="8dp">

                <ImageView
                    android:id="@+id/option3Image"
                    android:layout_width="110dp"
                    android:layout_height="110dp"
                    android:scaleType="fitCenter"
                    android:src="@drawable/cow" />

                <TextView
                    android:id="@+id/option3Label"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Cow"
                    android:textSize="17sp"
                    android:textStyle="bold"
                    android:textColor="#3E2723" />
            </LinearLayout>

            <LinearLayout
                android:id="@+id/option4"
                android:layout_width="0dp"
                android:layout_height="match_parent"
                android:layout_weight="1"
                android:layout_margin="6dp"
                android:orientation="vertical"
                android:gravity="center"
                android:background="@drawable/quiz_option_normal"
                android:elevation="4dp"
                android:padding="8dp">

                <ImageView
                    android:id="@+id/option4Image"
                    android:layout_width="110dp"
                    android:layout_height="110dp"
                    android:scaleType="fitCenter"
                    android:src="@drawable/wolf" />

                <TextView
                    android:id="@+id/option4Label"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Wolf"
                    android:textSize="17sp"
                    android:textStyle="bold"
                    android:textColor="#3E2723" />
            </LinearLayout>
        </LinearLayout>

    </LinearLayout>

    <!-- FEEDBACK -->
    <TextView
        android:id="@+id/feedbackText"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:gravity="center"
        android:text=""
        android:textSize="20sp"
        android:textStyle="bold"
        android:padding="4dp"
        app:layout_constraintBottom_toTopOf="@id/nextButton"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent" />

    <!-- NEXT BUTTON -->
    <Button
        android:id="@+id/nextButton"
        android:layout_width="0dp"
        android:layout_height="56dp"
        android:layout_margin="16dp"
        android:text="Next →"
        android:textSize="18sp"
        android:textStyle="bold"
        android:textColor="#FFFFFF"
        android:background="@drawable/btn_next"
        android:visibility="gone"
        android:stateListAnimator="@null"
        android:elevation="4dp"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent" />

</androidx.constraintlayout.widget.ConstraintLayout>